// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Necesario para despliegues con Supabase
}

enum Role {
  ESTUDIANTE
  EXALUMNO
  ADMIN
}

enum UserStatus {
  PENDIENTE
  ACTIVO
  SUSPENDIDO
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ESTUDIANTE)
  status        UserStatus @default(PENDIENTE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Perfiles extendidos
  estudiante    Estudiante?
  exalumno      Exalumno?
  
  // Relaciones generales
  reportesRecibidos ReportePerfil[] @relation("Reportado")
  reportesHechos    ReportePerfil[] @relation("Reportador")
  accounts          Account[]
  sessions          Session[]
}

model Estudiante {
  id              String   @id // FK a User.id
  user            User     @relation(fields: [id], references: [id], onDelete: Cascade)
  carrera         String
  nivelBeca       String?  // CRÍTICO: Dato privado
  avanceProyecto  Int      @default(0) // 0 a 100
  areaProyecto    String?  // Área principal del proyecto de graduación
  apoyoBuscado    String[] // Tags de lo que busca
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         Match[]  @relation("EstudianteMatch")
  aplicaciones    Aplicacion[]
  curriculum      Curriculum?
}

model Exalumno {
  id              String   @id // FK a User.id
  user            User     @relation(fields: [id], references: [id], onDelete: Cascade)
  carrera         String
  sector          String
  areasInteres    String[] // Catálogo estricto (14 áreas)
  apoyoOfrecido   String[] // Mentoria, Pasantias, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         Match[]      @relation("ExalumnoMatch")
  donaciones      Donacion[]
  posiciones      Posicion[]
}

enum MatchStatus {
  SUGERIDO
  CONTACTADO
  ACTIVO
}

model Match {
  id              String      @id @default(uuid())
  estudianteId    String
  exalumnoId      String
  afinidad        Int         // 0 a 100 puntos calculados
  status          MatchStatus @default(SUGERIDO)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  estudiante      Estudiante  @relation("EstudianteMatch", fields: [estudianteId], references: [id], onDelete: Cascade)
  exalumno        Exalumno    @relation("ExalumnoMatch", fields: [exalumnoId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, exalumnoId])
}

enum DonacionStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Donacion {
  id              String         @id @default(uuid())
  exalumnoId      String
  monto           Float
  comprobanteUrl  String         // URL en Supabase Storage
  status          DonacionStatus @default(PENDIENTE)
  destino         String         // Proyecto específico o Fondo General
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  exalumno        Exalumno       @relation(fields: [exalumnoId], references: [id], onDelete: Cascade)
}

model ReportePerfil {
  id              String   @id @default(uuid())
  reportadorId    String
  reportadoId     String
  motivo          String
  createdAt       DateTime @default(now())

  reportador      User     @relation("Reportador", fields: [reportadorId], references: [id], onDelete: Cascade)
  reportado       User     @relation("Reportado", fields: [reportadoId], references: [id], onDelete: Cascade)
}

enum TipoPosicion {
  EMPLEO
  PASANTIA
}

model Posicion {
  id              String       @id @default(uuid())
  exalumnoId      String
  titulo          String
  tipo            TipoPosicion
  descripcion     String
  habilidades     String[]
  fechaLimite     DateTime
  activa          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  exalumno        Exalumno     @relation(fields: [exalumnoId], references: [id], onDelete: Cascade)
  aplicaciones    Aplicacion[]
}

enum EstadoAplicacion {
  PENDIENTE
  SELECCIONADO
  DESCARTADO
}

model Aplicacion {
  id              String           @id @default(uuid())
  posicionId      String
  estudianteId    String
  cvVersionId     String
  estado          EstadoAplicacion @default(PENDIENTE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  posicion        Posicion          @relation(fields: [posicionId], references: [id], onDelete: Cascade)
  estudiante      Estudiante        @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cvVersion       CurriculumVersion @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
}

model Curriculum {
  id              String   @id @default(uuid())
  estudianteId    String   @unique
  datosBase       Json     // Estructura ATS base del CV
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  estudiante      Estudiante          @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  versiones       CurriculumVersion[]
}

model CurriculumVersion {
  id              String     @id @default(uuid())
  curriculumId    String
  contenido       Json       // Versión específica para una aplicación (adaptada por usuario o IA)
  creadoPorIA     Boolean    @default(false)
  createdAt       DateTime   @default(now())

  curriculum      Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  aplicaciones    Aplicacion[]
}

// ----------------------------------------------------------------------
// Modelos obligatorios para NextAuth.js v5 (Adapter)
// ----------------------------------------------------------------------

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
